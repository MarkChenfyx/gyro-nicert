GYRO_ENV=development

# Browser origins allowed to call the API directly. The Docker frontend uses a
# same-origin /api proxy and does not need an additional origin here.
GYRO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Docker Compose host bindings. Keep the loopback defaults unless access from
# another machine or a host-level reverse proxy is intentionally configured.
GYRO_WEB_BIND=127.0.0.1
GYRO_WEB_PORT=8080
GYRO_BACKEND_BIND=127.0.0.1
GYRO_BACKEND_PORT=8000

# Runtime run retention. Pruning happens only after a baseline completes successfully.
GYRO_RUN_RETENTION=50

# Automatically cancel and archive queued/running tasks that stop updating.
# Set to 0 to disable stale-task cleanup.
GYRO_TASK_STALE_AFTER_HOURS=6

# RQData credentials used by the market data downloader.
GYRO_RQDATA_USERNAME=
GYRO_RQDATA_PASSWORD=

# Strategy generation.
GYRO_LLM_PROVIDER=openai_compatible
GYRO_LLM_API_KEY=
GYRO_LLM_BASE_URL=https://api.openai.com/v1
GYRO_LLM_MODEL=gpt-4o-mini
GYRO_LLM_TIMEOUT=60
GYRO_LLM_TEMPERATURE=0.1

# DeepSeek example:
# GYRO_LLM_PROVIDER=deepseek
# GYRO_LLM_BASE_URL=https://api.deepseek.com/v1
# GYRO_LLM_MODEL=deepseek-chat

# Kimi example:
# GYRO_LLM_PROVIDER=kimi
# GYRO_LLM_BASE_URL=https://api.moonshot.cn/v1
# GYRO_LLM_MODEL=moonshot-v1-8k

# Backward-compatible OpenAI-style aliases are also accepted:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT=60
